server:
  port: ":8080"
grpc:
  addr: "localhost:50051"
redis:
  addr: "localhost:6379"
  password: ""
  db: 0
jwt:
  secret: "change-me-in-production"
  ttl: 72
cache:
  ttl: 600
auth:
  # 默认开启 JWT 鉴权；本地/演示如需直连可用环境变量 AUTH_ENABLED=0 覆盖关闭。
  enabled: true
  username: "admin"
  password: "admin123"
rate:
  limit: 60
  window: 60
